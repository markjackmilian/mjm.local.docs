@using MudBlazor
@using Mjm.LocalDocs.Core.Models

<MudDialog>
    <DialogContent>
        @if (Versions is null || Versions.Count == 0)
        {
            <MudText Typo="Typo.body1" Style="color: var(--ld-text-secondary);">No versions found.</MudText>
        }
        else
        {
            <div style="border: 1px solid var(--ld-border); border-radius: var(--ld-radius-md); overflow: hidden;">
                <MudSimpleTable Dense="true" Hover="true" Style="overflow-x: auto;">
                    <thead>
                        <tr>
                            <th>Version</th>
                            <th>File Name</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var version in Versions)
                        {
                            <tr style="@GetRowStyle(version)">
                                <td>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="@(version.Id == CurrentDocumentId ? Variant.Filled : Variant.Outlined)"
                                             Style="@(version.Id == CurrentDocumentId ? "background: var(--ld-primary-lightest); color: var(--ld-primary);" : "color: var(--ld-text-secondary); border-color: var(--ld-border);")">
                                        v@(version.VersionNumber)
                                    </MudChip>
                                </td>
                                <td><MudText Typo="Typo.body2">@version.FileName</MudText></td>
                                <td><MudText Typo="Typo.body2" Style="color: var(--ld-text-secondary);">@version.FileExtension</MudText></td>
                                <td><MudText Typo="Typo.body2" Style="color: var(--ld-text-secondary);">@FormatFileSize(version.FileSizeBytes)</MudText></td>
                                <td><MudText Typo="Typo.body2" Style="color: var(--ld-text-secondary);">@version.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</MudText></td>
                                <td>
                                    @if (version.IsSuperseded)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background: #FEF3C7; color: #92400E;">
                                            Superseded
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background: #ECFDF5; color: #065F46;">
                                            Current
                                        </MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text" Style="color: var(--ld-text-secondary);">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public IReadOnlyList<Document>? Versions { get; set; }

    [Parameter]
    public string CurrentDocumentId { get; set; } = string.Empty;

    private void Close() => MudDialog?.Close();

    private string GetRowStyle(Document version)
    {
        if (version.Id == CurrentDocumentId)
            return "background-color: var(--ld-primary-lightest);";

        return version.IsSuperseded ? "opacity: 0.5;" : string.Empty;
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        int order = 0;
        double size = bytes;

        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }

        return $"{size:0.##} {sizes[order]}";
    }
}
