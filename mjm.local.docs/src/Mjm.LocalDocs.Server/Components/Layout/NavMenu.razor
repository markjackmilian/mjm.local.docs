@inject NavigationManager Navigation

<div style="padding: 20px 16px 12px 16px;">
    <p class="ld-section-title" style="padding-left: 12px;">MENU</p>
</div>

<MudNavMenu Color="Color.Primary" Bordered="true" Class="px-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" 
                Icon="@Icons.Material.Rounded.SpaceDashboard"
                Style="border-radius: 8px; margin-bottom: 2px; color: rgba(255,255,255,0.7);">
        Dashboard
    </MudNavLink>
    <MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" 
                Icon="@Icons.Material.Rounded.FolderCopy"
                Style="border-radius: 8px; margin-bottom: 2px; color: rgba(255,255,255,0.7);">
        Projects
    </MudNavLink>
    <MudNavLink Href="/mcp-config" Match="NavLinkMatch.All" 
                Icon="@Icons.Material.Rounded.Cable"
                Style="border-radius: 8px; margin-bottom: 2px; color: rgba(255,255,255,0.7);">
        MCP Config
    </MudNavLink>
    <MudNavLink Href="/settings/tokens" Match="NavLinkMatch.All" 
                Icon="@Icons.Material.Rounded.VpnKey"
                Style="border-radius: 8px; margin-bottom: 2px; color: rgba(255,255,255,0.7);">
        API Tokens
    </MudNavLink>
</MudNavMenu>
