@page "/projects"
@attribute [Authorize]
@rendermode InteractiveServer
 @using Mjm.LocalDocs.Core.Abstractions
 @using Mjm.LocalDocs.Core.Models
 @using Mjm.LocalDocs.Core.Services
 @inject IProjectRepository ProjectRepository
 @inject IDocumentRepository DocumentRepository
 @inject ProjectService ProjectService
 @inject NavigationManager Navigation
 @inject IDialogService DialogService
 @inject ISnackbar Snackbar

 <PageTitle>Projects - Local Docs</PageTitle>

 <div class="d-flex justify-space-between align-center mb-6">
     <div>
         <MudText Typo="Typo.h4" Class="ld-heading">Projects</MudText>
         <MudText Typo="Typo.body2" Style="color: var(--ld-text-secondary); margin-top: 4px;">
             Manage your document collections
         </MudText>
     </div>
     <MudButton Variant="Variant.Filled" 
                Color="Color.Primary" 
                StartIcon="@Icons.Material.Rounded.Add"
                Style="border-radius: var(--ld-radius-pill); padding: 8px 24px;"
                OnClick="@(() => Navigation.NavigateTo("/projects/new"))">
         New Project
     </MudButton>
 </div>

 @if (_loading)
 {
     <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto d-block my-8" />
 }
 else if (_projects.Count == 0)
 {
     <div class="ld-empty-state">
         <MudIcon Icon="@Icons.Material.Rounded.FolderOff" 
                  Style="font-size: 3rem; color: var(--ld-text-disabled); margin-bottom: 12px;" />
         <MudText Style="font-size: 0.9375rem; font-weight: 600; color: var(--ld-text-primary); margin-bottom: 4px;">
             No projects found
         </MudText>
         <MudText Style="font-size: 0.8125rem; color: var(--ld-text-secondary);">
             Click "New Project" to create one.
         </MudText>
     </div>
 }
 else
 {
     <MudTextField @bind-Value="_searchText"
                   Placeholder="Search projects..."
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Rounded.Search"
                   Immediate="true"
                   DebounceInterval="300"
                   Variant="Variant.Outlined"
                   Class="mb-4"
                   Style="max-width: 400px;"
                   Clearable="true"
                   OnClearButtonClick="@(() => { _searchText = string.Empty; })" />

     <MudPaper Elevation="0" Style="border: 1px solid var(--ld-border); border-radius: var(--ld-radius-lg); overflow: hidden;">
         <MudDataGrid T="ProjectListItem"
                      Items="@FilteredProjects"
                      SortMode="SortMode.Single"
                      Filterable="false"
                      Hideable="false"
                      Dense="false"
                      Hover="true">
             <Columns>
                 <TemplateColumn Title="Name" Sortable="true">
                     <CellTemplate>
                         <MudLink Href="@($"/projects/{context.Item.Project.Id}")" 
                                  Typo="Typo.body2" 
                                  Color="Color.Primary"
                                  Style="font-weight: 600;">
                             @context.Item.Project.Name
                         </MudLink>
                     </CellTemplate>
                 </TemplateColumn>
                 <TemplateColumn Title="Description" Sortable="true">
                     <CellTemplate>
                         <MudText Typo="Typo.body2" Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ld-text-secondary);">
                             @(context.Item.Project.Description ?? "-")
                         </MudText>
                     </CellTemplate>
                 </TemplateColumn>
                 <TemplateColumn Title="Documents" Sortable="true">
                     <CellTemplate>
                         <MudChip T="string" Size="Size.Small" 
                                  Variant="Variant.Text"
                                  Style="background: var(--ld-chip-success-bg); color: var(--ld-chip-success-text); font-weight: 600;">
                             @context.Item.DocumentCount
                         </MudChip>
                     </CellTemplate>
                 </TemplateColumn>
                 <TemplateColumn Title="Created" Sortable="true">
                     <CellTemplate>
                         <MudText Typo="Typo.body2" Style="color: var(--ld-text-secondary);">
                             @context.Item.Project.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")
                         </MudText>
                     </CellTemplate>
                 </TemplateColumn>
                 <TemplateColumn Title="Actions" Sortable="false">
                     <CellTemplate>
                         <div class="d-flex" style="gap: 2px;">
                             <MudTooltip Text="Edit">
                                 <MudIconButton Icon="@Icons.Material.Rounded.Edit" 
                                                Size="Size.Small" 
                                                Color="Color.Primary"
                                                OnClick="@(() => Navigation.NavigateTo($"/projects/{context.Item.Project.Id}"))" />
                             </MudTooltip>
                             <MudTooltip Text="Delete">
                                 <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" 
                                                Size="Size.Small" 
                                                Color="Color.Error"
                                                OnClick="@(() => DeleteProjectAsync(context.Item.Project))" />
                             </MudTooltip>
                         </div>
                     </CellTemplate>
                 </TemplateColumn>
             </Columns>
         </MudDataGrid>
     </MudPaper>
 }

 @code {
     private bool _loading = true;
     private List<ProjectListItem> _projects = [];
     private string _searchText = string.Empty;

     private IEnumerable<ProjectListItem> FilteredProjects => string.IsNullOrWhiteSpace(_searchText)
         ? _projects
         : _projects
             .Where(p => p.Project.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                         (p.Project.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));

     protected override async Task OnInitializedAsync()
     {
         await LoadProjectsAsync();
     }

     private async Task LoadProjectsAsync()
     {
         _loading = true;
         StateHasChanged();
         
         var projects = await ProjectRepository.GetAllAsync();
         _projects.Clear();

          foreach (var project in projects)
          {
              var docs = await DocumentRepository.GetDocumentsByProjectAsync(project.Id);
              var activeCount = docs.Count(d => !d.IsSuperseded);
              _projects.Add(new ProjectListItem(project, activeCount));
          }

         _loading = false;
     }

     private async Task DeleteProjectAsync(Project project)
     {
         var parameters = new DialogParameters<ConfirmDialog>
         {
             { x => x.ContentText, $"Are you sure you want to delete project \"{project.Name}\"? All documents and associated data will also be deleted." },
             { x => x.ButtonText, "Delete" },
             { x => x.Color, Color.Error }
         };

         var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
         var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Deletion", parameters, options);
         var result = await dialog.Result;

         if (result is { Canceled: false })
         {
             try
             {
                 var deleted = await ProjectService.DeleteProjectAsync(project.Id);
                 if (deleted)
                 {
                     Snackbar.Add($"Project \"{project.Name}\" deleted successfully.", Severity.Success);
                     await LoadProjectsAsync();
                 }
                 else
                 {
                     Snackbar.Add("Error deleting project.", Severity.Error);
                 }
             }
             catch (Exception ex)
             {
                 Snackbar.Add($"Project deletion did not finish and must be retried: {ex.Message}", Severity.Error);
             }
         }
     }

     private sealed record ProjectListItem(Project Project, int DocumentCount);
 }
