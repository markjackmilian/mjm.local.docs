{
  "ConnectionStrings": {
    "LocalDocs": "Server=<sql-server-host>;Database=<database-name>;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "LocalDocs": {
    "Authentication": {
      "Username": "<username>",
      "Password": "<password>"
    },
    "Mcp": {
      "RequireAuthentication": true
    },
    "Embeddings": {
      "Provider": "OpenAI",
      "Dimension": 1536,
      "OpenAI": {
        "ApiKey": "<YOUR_OPENAI_API_KEY>",
        "Model": "text-embedding-3-small"
      }
    },
    "Storage": {
      "Provider": "SqlServer",
      "SqlServer": {
        "Schema": "dbo",
        "TableName": "chunk_embeddings",
        "UseVectorIndex": true,
        "DistanceMetric": "cosine"
      }
    },
    "FileStorage": {
      "Provider": "FileSystem",
      "FileSystem": {
        "BasePath": "DocumentFiles",
        "CreateDirectoryIfNotExists": true
      }
    },
    "Chunking": {
      "MaxChunkSize": 3000,
      "OverlapSize": 300
    },
    "Chat": {
      "Enabled": true,
      "Provider": "OpenAI",
      "MaxContextChunks": 5,
      "AgenticMode": false,
      "OpenAI": {
        "ApiKey": "<YOUR_OPENAI_API_KEY>",
        "Model": "gpt-4o-mini"
      }
    }
  }
}
