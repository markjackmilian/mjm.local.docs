<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Mjm.LocalDocs.Server.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
    <script>
        // Apply dark mode immediately to prevent flash of wrong theme.
        // Runs before any rendering occurs.
        (function() {
            var saved = localStorage.getItem('darkMode');
            var isDark = saved !== null 
                ? saved === 'true' 
                : window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (isDark) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>

<body>
    <Routes />
    <MudPopoverProvider @rendermode="InteractiveServer" />
    <MudDialogProvider @rendermode="InteractiveServer" />
    <MudSnackbarProvider @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.scrollToBottom = function(elementId) {
            var el = document.getElementById(elementId);
            if (el) { el.scrollTop = el.scrollHeight; }
        };

        window.downloadFile = function(fileName, base64Content, mimeType) {
            const link = document.createElement('a');
            link.href = 'data:' + mimeType + ';base64,' + base64Content;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.themeStorage = {
            get: function() {
                return localStorage.getItem('darkMode');
            },
            set: function(value) {
                localStorage.setItem('darkMode', value);
            },
            getSystemPreference: function() {
                return window.matchMedia('(prefers-color-scheme: dark)').matches;
            },
            apply: function(isDark) {
                if (isDark) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            }
        };

        // Re-apply dark mode after Blazor enhanced navigation
        // (enhanced nav replaces DOM content but keeps the page alive)
        Blazor.addEventListener('enhancedload', function() {
            var saved = localStorage.getItem('darkMode');
            var isDark = saved !== null
                ? saved === 'true'
                : window.matchMedia('(prefers-color-scheme: dark)').matches;
            window.themeStorage.apply(isDark);
        });
    </script>
</body>

</html>
