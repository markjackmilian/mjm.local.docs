            PrimaryLighten = "#6EE7B7",
            Secondary = "#94A3B8",
            Tertiary = "#38BDF8",
            Info = "#38BDF8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            AppbarBackground = "#1E293B",
            AppbarText = "#F1F5F9",
            Background = "#0F172A",
            Surface = "#1E293B",
            DrawerBackground = "#1E293B",
            DrawerText = "#CBD5E1",
            DrawerIcon = "#94A3B8",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            TextDisabled = "#64748B",
            ActionDefault = "#94A3B8",
            ActionDisabled = "#475569",
            Divider = "#334155",
            DividerLight = "#1E293B",
            LinesDefault = "#334155",
            TableHover = "#064E3B",
            TableStriped = "#0F172A"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Roboto", "Helvetica", "Arial", "sans-serif"],
                FontSize = "0.875rem",
                LineHeight = "1.5"
            },
            H4 = new H4Typography { FontWeight = "700", FontSize = "1.75rem", LetterSpacing = "-0.025em", LineHeight = "1.2" },
            H5 = new H5Typography { FontWeight = "600", FontSize = "1.375rem", LetterSpacing = "-0.02em", LineHeight = "1.3" },
            H6 = new H6Typography { FontWeight = "600", FontSize = "1.125rem", LetterSpacing = "-0.015em", LineHeight = "1.4" },
            Subtitle1 = new Subtitle1Typography { FontWeight = "600", FontSize = "0.9375rem" },
            Body1 = new Body1Typography { FontSize = "0.9375rem", LineHeight = "1.6" },
            Body2 = new Body2Typography { FontSize = "0.8125rem", LineHeight = "1.5", FontWeight = "400" },
            Caption = new CaptionTypography { FontSize = "0.75rem", FontWeight = "500", LineHeight = "1.4" }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px",
            DrawerWidthLeft = "260px"
        },
        Shadows = new Shadow
        {
            Elevation =
            [
                "none",
                "0 1px 2px rgba(0,0,0,0.03)",
                "0 1px 3px rgba(0,0,0,0.04)",
                "0 4px 6px -1px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
