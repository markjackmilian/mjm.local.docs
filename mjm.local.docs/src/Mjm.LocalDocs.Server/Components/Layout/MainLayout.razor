@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="false" />

<MudLayout>
    <MudAppBar Elevation="0" Style="background: var(--ld-appbar); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <div class="d-flex align-center ml-2" style="gap: 10px;">
            <MudIcon Icon="@Icons.Material.Rounded.AutoStories" Style="font-size: 1.5rem; color: #818CF8;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.025em; color: white;">
                Local Docs
            </MudText>
        </div>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudAvatar Size="Size.Small" Style="background: rgba(99, 102, 241, 0.2); color: #818CF8; font-size: 0.75rem; width: 32px; height: 32px;">
                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </MudAvatar>
                    <MudText Style="color: rgba(255,255,255,0.7); font-size: 0.875rem;">@context.User.Identity?.Name</MudText>
                    <MudTooltip Text="Logout">
                        <MudIconButton Icon="@Icons.Material.Rounded.Logout" 
                                       Style="color: rgba(255,255,255,0.5);" 
                                       Size="Size.Small"
                                       Href="/logout" />
                    </MudTooltip>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Style="background: var(--ld-drawer); border-right: 1px solid rgba(255,255,255,0.06);">
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent Style="padding-top: 72px; padding-left: 8px; padding-right: 8px; background: var(--ld-background);">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

