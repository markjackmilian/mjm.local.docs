@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@inject NavigationManager Navigation

<PageTitle>Login - Local Docs</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        @* Logo & Branding *@
        <div class="login-header">
            <div class="login-logo">
                <MudIcon Icon="@Icons.Material.Rounded.AutoStories" Style="font-size: 1.75rem; color: white;" />
            </div>
            <MudText Style="font-size: 1.5rem; font-weight: 700; letter-spacing: -0.025em; color: var(--ld-text-primary);">
                Local Docs
            </MudText>
            <MudText Style="font-size: 0.875rem; color: var(--ld-text-secondary); margin-top: 4px;">
                Sign in to your account
            </MudText>
        </div>

        @if (_showError)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _showError = false)"
                      Style="border-radius: 10px;">
                Invalid credentials. Please try again.
            </MudAlert>
        }

        <form action="/api/login" method="post">
            <MudTextField @bind-Value="_username"
                          Placeholder="Username"
                          Variant="Variant.Outlined"
                          InputType="InputType.Text"
                          Required="true"
                          RequiredError="Username is required"
                          Class="mb-3"
                          name="username"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Person" />

            <MudTextField @bind-Value="_password"
                          Placeholder="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Required="true"
                          RequiredError="Password is required"
                          Class="mb-3"
                          name="password"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Lock" />

            <div class="d-flex justify-space-between align-center mb-5">
                <MudCheckBox @bind-Value="_rememberMe" 
                             Label="Remember me" 
                             Color="Color.Primary"
                             Size="Size.Small"
                             Dense="true" />
                <MudButton Variant="Variant.Text" 
                           Size="Size.Small" 
                           Color="Color.Primary"
                           OnClick="@(() => _showPassword = !_showPassword)"
                           Style="font-size: 0.8125rem;">
                    @(_showPassword ? "Hide" : "Show")
                </MudButton>
            </div>
            <input type="hidden" name="rememberMe" value="@(_rememberMe ? "true" : "false")" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Style="height: 48px; font-weight: 600; font-size: 0.9375rem; letter-spacing: 0; border-radius: 10px;">
                Sign In
            </MudButton>
        </form>
    </div>

    <MudText Style="font-size: 0.75rem; color: var(--ld-text-muted); margin-top: 32px;">
        Local Docs &mdash; Semantic Document Search
    </MudText>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: linear-gradient(160deg, #F8FAFC 0%, #EEF2FF 50%, #F8FAFC 100%);
    }

    .login-card {
        width: 100%;
        max-width: 400px;
        background: white;
        border-radius: 16px;
        padding: 40px 36px 36px 36px;
        border: 1px solid var(--ld-border);
        box-shadow: 0 4px 24px rgba(15, 23, 42, 0.06);
    }

    .login-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .login-logo {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #6366F1, #4F46E5);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px auto;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 32px 24px 28px 24px;
            border-radius: 12px;
        }
    }
</style>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _rememberMe;
    private bool _showPassword;
    private bool _showError;

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        _showError = !string.IsNullOrEmpty(Error);
    }
}
