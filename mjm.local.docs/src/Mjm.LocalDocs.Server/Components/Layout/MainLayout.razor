@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="false" />

<MudLayout>
    <MudAppBar Elevation="0" Style="background: white; border-bottom: 1px solid #E5E7EB;">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Style="color: #6B7280;" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <div class="d-flex align-center ml-2" style="gap: 10px;">
            <div style="width: 32px; height: 32px; border-radius: 10px; background: linear-gradient(135deg, #10B981, #059669); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Rounded.AutoStories" Style="font-size: 1.125rem; color: white;" />
            </div>
            <MudText Style="font-size: 1.125rem; font-weight: 700; letter-spacing: -0.025em; color: #111827;">
                Local Docs
            </MudText>
        </div>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudAvatar Size="Size.Small" Style="background: #D1FAE5; color: #059669; font-size: 0.75rem; font-weight: 600; width: 32px; height: 32px;">
                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </MudAvatar>
                    <MudText Style="color: #6B7280; font-size: 0.875rem; font-weight: 500;">@context.User.Identity?.Name</MudText>
                    <MudTooltip Text="Logout">
                        <MudIconButton Icon="@Icons.Material.Rounded.Logout" 
                                       Style="color: #9CA3AF;" 
                                       Size="Size.Small"
                                       Href="/logout" />
                    </MudTooltip>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Style="background: white; border-right: 1px solid #E5E7EB;">
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent Style="padding-top: 72px; padding-left: 8px; padding-right: 8px; background: #F9FAFB;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

