{
  "ConnectionStrings": {
    "LocalDocs": "Data Source=localdocs.db"
  },
  "LocalDocs": {
    "Authentication": {
      "Username": "<username>",
      "Password": "<password>"
    },
    "Mcp": {
      "RequireAuthentication": true
    },
    "Embeddings": {
      "Provider": "Ollama",
      "Dimension": 768,
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "nomic-embed-text"
      }
    },
    "Storage": {
      "Provider": "Sqlite"
    },
    "FileStorage": {
      "Provider": "Database"
    },
    "Chunking": {
      "MaxChunkSize": 3000,
      "OverlapSize": 300
    },
    "Chat": {
      "Enabled": true,
      "Provider": "Ollama",
      "MaxContextChunks": 5,
      "AgenticMode": false,
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "llama3.2"
      }
    }
  }
}
