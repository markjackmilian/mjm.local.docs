@using System.Globalization
@using Mjm.LocalDocs.Core.Models.Dashboard

@* Stacked bars: solid = brand-new documents, faded = new versions of existing ones.
   The split is the point — steady bars with a shrinking solid portion mean the
   knowledge base is being rewritten, not expanded.

   Hand-rolled rather than MudChart: the library takes its colours from C# and cannot
   read the --ld-* tokens, so a charted card could never follow the light/dark theme. *@

<MudPaper Class="pa-5" Elevation="0" Style="border-radius: var(--ld-radius-lg); height: 100%;">
    <div class="d-flex align-center justify-space-between mb-4" style="gap: 12px;">
        <div>
            <p class="ld-section-title" style="margin-bottom: 2px;">KNOW-HOW GROWTH</p>
            <MudText Style="font-size: 0.75rem; color: var(--ld-text-muted);">
                New documents vs new versions
            </MudText>
        </div>
        <div class="ld-segmented" role="group" aria-label="Bucket size">
            <button type="button"
                    class="ld-segmented-item"
                    aria-pressed="@Pressed(GrowthGranularity.Monthly)"
                    @onclick="@(() => OnGranularityChanged(GrowthGranularity.Monthly))">Months</button>
            <button type="button"
                    class="ld-segmented-item"
                    aria-pressed="@Pressed(GrowthGranularity.Weekly)"
                    @onclick="@(() => OnGranularityChanged(GrowthGranularity.Weekly))">Weeks</button>
        </div>
    </div>

    @if (HasAnyContribution)
    {
        var ceiling = NiceCeiling(Buckets.Max(b => b.NewDocuments + b.NewVersions));

        <div class="ld-gc-plot">
            @for (var tick = TickCount; tick >= 0; tick--)
            {
                var isBaseline = tick == 0;
                <div class="ld-gc-row @(isBaseline ? "ld-gc-row-base" : null)"
                     style="bottom: @Percent((double)tick / TickCount);">
                    <span class="ld-gc-ytick">@(ceiling / TickCount * tick)</span>
                    <span class="ld-gc-line"></span>
                </div>
            }
            <div class="ld-gc-bands">
                @foreach (var bucket in Buckets)
                {
                    var faded = bucket.IsPartial ? "ld-gc-partial" : null;
                    <div class="ld-gc-band" title="@Tooltip(bucket)">
                        <span class="ld-gc-band-glow"></span>
                        @if (bucket.NewDocuments + bucket.NewVersions == 0)
                        {
                            <span class="ld-gc-stub @faded"></span>
                        }
                        else
                        {
                            <span class="ld-gc-stack @faded">
                                @if (bucket.NewDocuments > 0)
                                {
                                    <span class="ld-gc-seg ld-gc-seg-1"
                                          style="height: @Percent((double)bucket.NewDocuments / ceiling);"></span>
                                }
                                @if (bucket.NewVersions > 0)
                                {
                                    <span class="ld-gc-seg ld-gc-seg-2"
                                          style="height: @Percent((double)bucket.NewVersions / ceiling);"></span>
                                }
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="ld-gc-xaxis">
            @foreach (var bucket in Buckets)
            {
                <span class="ld-gc-xtick @(bucket.IsPartial ? "ld-gc-xtick-current" : null)">@bucket.Label</span>
            }
        </div>

        <div class="ld-gc-footer">
            <div class="ld-gc-legend">
                <span class="ld-gc-legend-item">
                    <span class="ld-gc-dot ld-gc-dot-1"></span>New documents
                </span>
                <span class="ld-gc-legend-item">
                    <span class="ld-gc-dot ld-gc-dot-2"></span>New versions
                </span>
            </div>
            @if (Buckets[^1].IsPartial)
            {
                <span class="ld-gc-note">The last bar covers a period still in progress.</span>
            }
        </div>
    }
    else
    {
        <div class="ld-empty-state">
            <MudIcon Icon="@Icons.Material.Rounded.ShowChart"
                     Style="font-size: 2.5rem; color: var(--ld-text-disabled); margin-bottom: 8px;" />
            <MudText Style="font-size: 0.875rem; font-weight: 600; color: var(--ld-text-primary);">
                No contributions in this window
            </MudText>
            <MudText Style="font-size: 0.8125rem; color: var(--ld-text-secondary);">
                Add documents to a project and the growth will show up here.
            </MudText>
        </div>
    }
</MudPaper>

@code {
    /// <summary>Twelve buckets, oldest first.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<GrowthBucket> Buckets { get; set; } = [];

    /// <summary>Currently selected bucket size.</summary>
    [Parameter] public GrowthGranularity Granularity { get; set; } = GrowthGranularity.Monthly;

    /// <summary>Raised when the user switches bucket size.</summary>
    [Parameter] public EventCallback<GrowthGranularity> GranularityChanged { get; set; }

    /// <summary>Gridline intervals below the axis maximum.</summary>
    private const int TickCount = 4;

    /// <summary>Leading digits a nice axis step is allowed to start with.</summary>
    private static readonly int[] StepUnits = [1, 2, 5];

    private bool HasAnyContribution =>
        Buckets.Any(b => b.NewDocuments > 0 || b.NewVersions > 0);

    private Task OnGranularityChanged(GrowthGranularity granularity)
    {
        Granularity = granularity;
        return GranularityChanged.InvokeAsync(granularity);
    }

    // Blazor drops a bool-valued attribute when it is false, which would defeat the
    // [aria-pressed="true"] selector that paints the active segment. Hence strings.
    private string Pressed(GrowthGranularity granularity) =>
        Granularity == granularity ? "true" : "false";

    /// <summary>
    /// Smallest axis maximum that divides into <see cref="TickCount"/> whole steps, so a bar of
    /// four is not left as a stub under an axis that auto-scaled itself to twenty.
    /// </summary>
    private static int NiceCeiling(int max)
    {
        if (max <= TickCount)
        {
            return TickCount;
        }

        for (var magnitude = 1; magnitude <= 100_000_000; magnitude *= 10)
        {
            foreach (var unit in StepUnits)
            {
                var ceiling = unit * magnitude * TickCount;
                if (ceiling >= max)
                {
                    return ceiling;
                }
            }
        }

        return max;
    }

    // Inline style values, so the decimal separator has to stay a dot whatever the server culture.
    private static string Percent(double fraction) =>
        (fraction * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string Tooltip(GrowthBucket bucket)
    {
        var documents = $"{bucket.NewDocuments} new document{(bucket.NewDocuments == 1 ? "" : "s")}";
        var versions = $"{bucket.NewVersions} new version{(bucket.NewVersions == 1 ? "" : "s")}";
        var progress = bucket.IsPartial ? " (still in progress)" : string.Empty;

        return $"{bucket.Label} — {documents}, {versions}{progress}";
    }
}
