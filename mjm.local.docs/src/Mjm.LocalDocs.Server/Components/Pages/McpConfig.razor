@page "/mcp-config"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Mjm.LocalDocs.Core.Models
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IOptions<McpOptions> McpOptions
@inject NavigationManager Navigation

<PageTitle>MCP Configuration - Local Docs</PageTitle>

<div class="mb-6">
    <MudText Typo="Typo.h4" Class="ld-heading">MCP Configuration</MudText>
    <MudText Typo="Typo.body2" Style="color: var(--ld-text-secondary); margin-top: 4px;">
        Configure your AI coding assistant to connect to the Local Docs MCP server.
    </MudText>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined" Dense="true">
    <MudText Typo="Typo.body2">
        Make sure the Local Docs server is running at <code>@ServerUrl</code> before configuring your client.
    </MudText>
</MudAlert>

@if (McpOptions.Value.RequireAuthentication)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined" Dense="true">
        <MudText Typo="Typo.body2">
            <strong>Authentication Required:</strong> The MCP server requires a Bearer token.
            <MudLink Href="/settings/tokens" Typo="Typo.body2">Create an API Token</MudLink> and add it to the configuration.
        </MudText>
    </MudAlert>
}

<MudPaper Elevation="0" Style="border: 1px solid var(--ld-border); border-radius: var(--ld-radius-lg); overflow: hidden;">
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pa-5" 
             SliderColor="Color.Primary" Color="Color.Transparent">
        <MudTabPanel Text="Claude Code" Icon="@Icons.Material.Rounded.Terminal">
            <MudText Typo="Typo.h6" Class="mb-3">Claude Code Configuration</MudText>
            
            <MudText Typo="Typo.body2" Class="mb-5" Style="color: var(--ld-text-secondary);">
                Claude Code is Anthropic's official CLI for Claude. Configure it using the CLI command or JSON configuration.
            </MudText>

            @* CLI Command *@
            <div class="mb-5">
                <div class="d-flex justify-space-between align-center mb-2">
                    <p class="ld-section-title" style="margin: 0;">CLI COMMAND (RECOMMENDED)</p>
                    <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy" 
                                   Size="Size.Small" 
                                   Style="color: var(--ld-text-muted);"
                                   OnClick="@(() => CopyToClipboardAsync(ClaudeCliCommand))" />
                </div>
                <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--ld-text-secondary);">
                    Run this command in your terminal:
                </MudText>
                <pre class="ld-code-block">@ClaudeCliCommand</pre>
            </div>

            @* JSON Configuration *@
            <div class="mb-5">
                <div class="d-flex justify-space-between align-center mb-2">
                    <p class="ld-section-title" style="margin: 0;">JSON CONFIGURATION</p>
                    <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy" 
                                   Size="Size.Small" 
                                   Style="color: var(--ld-text-muted);"
                                   OnClick="@(() => CopyToClipboardAsync(ClaudeJsonConfig))" />
                </div>
                <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--ld-text-secondary);">
                    Add to <code>.mcp.json</code> in your project root, or <code>~/.claude.json</code> for global access:
                </MudText>
                <pre class="ld-code-block">@ClaudeJsonConfig</pre>
            </div>

            @* Verification *@
            <p class="ld-section-title">VERIFICATION</p>
            <MudList T="string" Dense="true">
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircleOutline" IconColor="Color.Success">
                    Run <code>claude mcp list</code> to verify the server is registered
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircleOutline" IconColor="Color.Success">
                    In Claude Code, use <code>/mcp</code> to check the connection status
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircleOutline" IconColor="Color.Success">
                    Try asking Claude to search your documents using Local Docs
                </MudListItem>
            </MudList>

            <MudAlert Severity="Severity.Warning" Class="mt-4" Variant="Variant.Outlined" Dense="true">
                <MudText Typo="Typo.body2">
                    The <code>local</code> scope (default) makes the server available only in the current project.
                    Use <code>--scope user</code> to make it available globally.
                </MudText>
            </MudAlert>
        </MudTabPanel>

        <MudTabPanel Text="OpenCode" Icon="@Icons.Material.Rounded.Code">
            <MudText Typo="Typo.h6" Class="mb-3">OpenCode Configuration</MudText>
            
            <MudText Typo="Typo.body2" Class="mb-5" Style="color: var(--ld-text-secondary);">
                OpenCode is an open source AI coding agent. Add the MCP server to your <code>opencode.json</code> file.
            </MudText>

            @* JSON Configuration *@
            <div class="mb-5">
                <div class="d-flex justify-space-between align-center mb-2">
                    <p class="ld-section-title" style="margin: 0;">CONFIGURATION FILE</p>
                    <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy" 
                                   Size="Size.Small" 
                                   Style="color: var(--ld-text-muted);"
                                   OnClick="@(() => CopyToClipboardAsync(OpenCodeJsonConfig))" />
                </div>
                <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--ld-text-secondary);">
                    Add to your <code>opencode.json</code> or <code>opencode.jsonc</code> in your project root:
                </MudText>
                <pre class="ld-code-block">@OpenCodeJsonConfig</pre>
            </div>

            @* Verification *@
            <p class="ld-section-title">VERIFICATION</p>
            <MudList T="string" Dense="true">
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircleOutline" IconColor="Color.Success">
                    Run <code>opencode mcp list</code> to verify the server is registered
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircleOutline" IconColor="Color.Success">
                    Restart OpenCode to load the new configuration
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircleOutline" IconColor="Color.Success">
                    In your prompts, add <code>use local-docs</code> to use the MCP tools
                </MudListItem>
            </MudList>

            <MudAlert Severity="Severity.Info" Class="mt-4" Variant="Variant.Outlined" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>Tip:</strong> Add a rule to your <code>AGENTS.md</code>: 
                    <em>"When you need to search documents, use the local-docs MCP tools."</em>
                </MudText>
            </MudAlert>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@* Available Tools *@
<MudPaper Class="pa-5 mt-5" Elevation="0" Style="border: 1px solid var(--ld-border); border-radius: var(--ld-radius-lg);">
    <p class="ld-section-title">AVAILABLE MCP TOOLS</p>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--ld-text-secondary);">
        Once connected, the following tools will be available to your AI assistant:
    </MudText>
    
    <div style="border: 1px solid var(--ld-border); border-radius: var(--ld-radius-md); overflow: hidden;">
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <th>Tool</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code style="background: var(--ld-primary-lightest); color: var(--ld-primary); padding: 2px 8px; border-radius: 4px; font-size: 0.8125rem;">search_docs</code></td>
                    <td>Search for documents using semantic search across all projects</td>
                </tr>
                <tr>
                    <td><code style="background: var(--ld-primary-lightest); color: var(--ld-primary); padding: 2px 8px; border-radius: 4px; font-size: 0.8125rem;">list_projects</code></td>
                    <td>List all available projects in Local Docs</td>
                </tr>
                <tr>
                    <td><code style="background: var(--ld-primary-lightest); color: var(--ld-primary); padding: 2px 8px; border-radius: 4px; font-size: 0.8125rem;">add_document</code></td>
                    <td>Add a new document to a project</td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </div>
</MudPaper>

@code {
    private string ServerUrl => $"{Navigation.BaseUri.TrimEnd('/')}/mcp";
    
    private string ClaudeCliCommand => McpOptions.Value.RequireAuthentication
        ? $"claude mcp add local-docs --transport http --header \"Authorization: Bearer YOUR_TOKEN_HERE\" {ServerUrl}"
        : $"claude mcp add local-docs --transport http {ServerUrl}";
    
    private string ClaudeJsonConfig => McpOptions.Value.RequireAuthentication
        ? $@"{{
  ""mcpServers"": {{
    ""local-docs"": {{
      ""type"": ""http"",
      ""url"": ""{ServerUrl}"",
      ""headers"": {{
        ""Authorization"": ""Bearer YOUR_TOKEN_HERE""
      }}
    }}
  }}
}}"
        : $@"{{
  ""mcpServers"": {{
    ""local-docs"": {{
      ""type"": ""http"",
      ""url"": ""{ServerUrl}""
    }}
  }}
}}";

    private string OpenCodeJsonConfig => McpOptions.Value.RequireAuthentication
        ? $@"{{
  ""$schema"": ""https://opencode.ai/config.json"",
  ""mcp"": {{
    ""local-docs"": {{
      ""type"": ""remote"",
      ""url"": ""{ServerUrl}"",
      ""headers"": {{
        ""Authorization"": ""Bearer YOUR_TOKEN_HERE""
      }},
      ""enabled"": true
    }}
  }}
}}"
        : $@"{{
  ""$schema"": ""https://opencode.ai/config.json"",
  ""mcp"": {{
    ""local-docs"": {{
      ""type"": ""remote"",
      ""url"": ""{ServerUrl}"",
      ""enabled"": true
    }}
  }}
}}";

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("Copied to clipboard!", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to copy to clipboard", Severity.Error);
        }
    }
}
