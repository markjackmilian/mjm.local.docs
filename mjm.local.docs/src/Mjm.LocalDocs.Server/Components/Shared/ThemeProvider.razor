                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)",
                "0 10px 15px -3px rgba(0,0,0,0.05)"
            ]
        }
    };

    protected override void OnInitialized()
    {
        ThemeService.OnChange += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                var saved = await JS.InvokeAsync<string?>("themeStorage.get");
                bool isDark;
                
                if (saved is not null)
                {
                    isDark = saved == "true";
                }
                else
                {
                    isDark = await JS.InvokeAsync<bool>("themeStorage.getSystemPreference");
                }
                
                ThemeService.SetDarkMode(isDark);
                await JS.InvokeVoidAsync("themeStorage.apply", isDark);
            }
            catch
            {
                // JS interop not available during prerendering
            }
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
    }
}
