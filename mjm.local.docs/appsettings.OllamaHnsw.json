{
  "ConnectionStrings": {
    "LocalDocs": "Data Source=localdocs.db"
  },
  "LocalDocs": {
    "Authentication": {
      "Username": "<username>",
      "Password": "<password>"
    },
    "Mcp": {
      "RequireAuthentication": true
    },
    "Embeddings": {
      "Provider": "Ollama",
      "Dimension": 768,
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "nomic-embed-text"
      }
    },
    "Storage": {
      "Provider": "SqliteHnsw",
      "Hnsw": {
        "IndexPath": "hnsw_index.bin",
        "MaxConnections": 16,
        "EfConstruction": 200,
        "EfSearch": 100,
        "AutoSaveDelayMs": 5000
      }
    },
    "FileStorage": {
      "Provider": "FileSystem",
      "FileSystem": {
        "BasePath": "DocumentFiles",
        "CreateDirectoryIfNotExists": true
      }
    },
    "Chunking": {
      "MaxChunkSize": 3000,
      "OverlapSize": 300
    },
    "Chat": {
      "Enabled": true,
      "Provider": "Ollama",
      "MaxContextChunks": 5,
      "AgenticMode": false,
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "llama3.2"
      }
    }
  }
}
